# Network and storage
BOOP_ADDR=127.0.0.1:8080
BOOP_BASE_URL=http://localhost:8080
BOOP_DATA_DIR=./data

# Generate unique values; never commit real secrets.
BOOP_SESSION_SECRET=replace-with-at-least-32-random-bytes
BOOP_MASTER_KEY=replace-with-base64-of-exactly-32-random-bytes

# Set true behind HTTPS in production.
BOOP_SECURE_COOKIES=false

# Runtime limits
BOOP_MAX_UPLOAD_MB=10
BOOP_LOG_LEVEL=info
