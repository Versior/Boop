# Network and storage
BOOP_ADDR=127.0.0.1:8080
BOOP_BASE_URL=http://localhost:8080
BOOP_DATA_DIR=./data

# Generate unique values; never commit real secrets.
BOOP_SESSION_SECRET=replace-with-at-least-32-random-bytes
BOOP_MASTER_KEY=replace-with-base64-of-exactly-32-random-bytes

# Set true behind HTTPS in production.
BOOP_SECURE_COOKIES=false

# Runtime limits
BOOP_MAX_UPLOAD_MB=10
BOOP_LOG_LEVEL=info

# Uploads in an S3-compatible bucket (optional).
#
# Leave every one of these unset to keep uploads under BOOP_DATA_DIR. Set any of
# them and all five of the required ones must be set: the process refuses to
# start otherwise, naming the variable it is missing. See docs/STORAGE.md.
#
# BOOP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BOOP_R2_BUCKET=boop-uploads
# BOOP_R2_ACCESS_KEY_ID=
# BOOP_R2_SECRET_ACCESS_KEY=
# The hostname objects are read from: an R2 custom domain, or the bucket's
# r2.dev address. The signed API endpoint above is not a public read surface.
# BOOP_R2_PUBLIC_URL=https://uploads.example.com
# Optional. R2 signs with "auto", which is the default.
# BOOP_R2_REGION=auto
# Optional. Key namespace inside the bucket; written with or without slashes.
# BOOP_R2_PREFIX=uploads
